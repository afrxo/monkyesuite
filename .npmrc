# pnpm settings that the lockfile records and `--frozen-lockfile` verifies.
#
# pnpm-lock.yaml is generated with `settings.autoInstallPeers: false`, which came
# from a machine-level pnpm rc rather than from this repo. Anywhere without that
# machine config — CI, a Docker build, a new laptop — pnpm defaults to true and
# `pnpm install --frozen-lockfile` aborts with ERR_PNPM_LOCKFILE_CONFIG_MISMATCH
# before installing anything. Pinning it here is what makes the lockfile portable.
auto-install-peers=false
