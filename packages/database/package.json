  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
